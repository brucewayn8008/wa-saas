# wa-saas backend env — copy to .env and fill in. NEVER commit .env.
# In production, source these from a secret manager, not a file.

ENV=dev

# Postgres (needs the pgvector extension for memory/intent features)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wa_saas

# Redis (Celery broker + rate-limit buckets + debounce/typing state)
REDIS_URL=redis://localhost:6379/0

# Go whatsmeow gateway (legacy listening / single-number transport)
GO_GATEWAY_URL=http://localhost:5005

# wacli — near-term WhatsApp transport (https://wacli.sh/)
# Install: brew install openclaw/tap/wacli && wacli auth
# Keep sync warm while sending: wacli sync --follow
WACLI_BIN=wacli
WACLI_STORE_DIR=
WACLI_TIMEOUT_SECONDS=120
WACLI_WEBHOOK_SECRET=

# LLM providers
# Gemini is the default reply model; Anthropic is the escalation model for hot leads.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_ESCALATION_ENABLED=true

# Conversation timing (seconds)
REPLY_DEBOUNCE_SECONDS=6
USER_TYPING_TTL_SECONDS=12
TYPING_DELAY_MAX_SECONDS=6

# Clerk (auth + Organizations)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# CLERK_PEM_PUBLIC_KEY=

# WhatsApp Business Cloud API
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage (media) — S3 / Cloudflare R2 compatible
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
